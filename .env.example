# Infrlo dual-ingress production configuration
PORT=5000

# One runtime identity, two public domains and two independent Railway Registry records
INFRLO_NATIVE_HOST=qqnioc.infrlo.com
INFRLO_PRIMARY_INGRESS=cloudflare

# Stable Cloudflare Named Tunnel
CF_TUNNEL_HOSTNAME=infrlo-01.pp1.de5.net
CF_TUNNEL_TOKEN=<SECRET>
INFRLO_CF_QUICK_TUNNEL=0

# Stable shared node identity -- both domains use these same values
UUID=<PERSISTENT_UUID>
WS_PATH=<PERSISTENT_WS_PATH>
SUB_TOKEN=<PERSISTENT_SUB_TOKEN>
NODE_ID=infrlo-01
NODE_NAME=Infrlo-01

# Railway: CF preserves NODE_ID=infrlo-01; Native registers as infrlo-01-native
REGISTRY_URL=https://subscription-server-v2-production.up.railway.app
REGISTRY_TOKEN=<SECRET>
REGISTRY_PROOF=<PERSISTENT_SECRET>
INFRLO_ENABLE_REGISTRY=1
